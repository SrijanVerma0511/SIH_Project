# Backend-only environment variables. Never commit real secrets.
SUPABASE_URL=https://swzbglmhifrtbwswpzxs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN3emJnbG1oaWZydGJ3c3dwenhzIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODcxMzA1NCwiZXhwIjoyMTA0Mjg5MDU0fQ.REDACTED_SUPABASE_SERVICE_ROLE_KEY
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ENVIRONMENT=development
APP_NAME=ManakMitra API
APP_VERSION=0.1.0

# Operations endpoints: required for /ops/* in production.
OPS_ADMIN_TOKEN=your-ops-admin-token

# AI #1
LLM_API_KEY=your-gemini-api-key
LLM_API_KEY_2=your-gemini-api-key
LLM_API_KEY_3=your-gemini-api-key-3
LLM_API_KEY_4=your-gemini-api-key-4
LLM_MODEL=gemini-3.6-flash

# AI #2 (optional dedicated fallback keys; if blank, AI #1 keys are reused)
AI2_API_KEY=your-ai2-gemini-api-key
AI2_API_KEY_2=your-ai2-gemini-api-key-2
AI2_API_KEY_3=your-ai2-gemini-api-key-3
AI2_API_KEY_4=your-ai2-gemini-api-key-4
AI2_MODEL=gemini-3.6-flash

# Phase 8 — usage protection / cost control
MAX_MESSAGE_LENGTH=10000
MAX_REQUEST_SIZE_BYTES=32768
MAX_CONTEXT_SIZE_CHARS=24000
MAX_OUTPUT_TOKENS=2048
MAX_AI1_CALLS_PER_REQUEST=1
MAX_AI2_CALLS_PER_REQUEST=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_IP=60
RATE_LIMIT_CHAT_PER_IP=10
RATE_LIMIT_SEARCH_PER_IP=30

# Phase 9 — scheduled maintenance (disabled by default)
SCHEDULER_ENABLED=false
BIS_SYNC_ENABLED=false
BIS_SYNC_INTERVAL=86400
BIS_SYNC_RETRIES=1
CACHE_CLEANUP_INTERVAL=3600
USAGE_STATS_INTERVAL=3600
TEMPORARY_DATA_CLEANUP_INTERVAL=3600

# Phase 10 — semantic embeddings / pgvector
# Gemini Embedding 2 is the default provider. 768 is the Phase 10 pgvector dimension.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_INPUT_CHARS=12000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RETRIES=2

# Hybrid ranking weights (automatically normalized if their sum is not 1).
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.35
HYBRID_METADATA_WEIGHT=0.10
VECTOR_MIN_SIMILARITY=0.0
